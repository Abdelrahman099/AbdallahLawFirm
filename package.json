    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "i18next": "^26.5.11",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.23.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.9",
